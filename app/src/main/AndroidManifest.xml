package com.rian.dokumen

import android.content.Intent
import android.graphics.BitmapFactory
import android.content.ContentValues
import android.os.Bundle
import android.os.Environment
import android.provider.MediaStore
import android.widget.Toast
import androidx.activity.ComponentActivity
import androidx.activity.compose.rememberLauncherForActivityResult
import androidx.activity.compose.setContent
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.foundation.ExperimentalFoundationApi
import androidx.compose.foundation.Image
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.grid.GridCells
import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
import androidx.compose.foundation.pager.HorizontalPager
import androidx.compose.foundation.pager.rememberPagerState
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.asImageBitmap
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import java.io.File
import java.text.SimpleDateFormat
import java.util.*

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent { App() }
    }
}

@OptIn(ExperimentalFoundationApi::class)
@Composable
fun App() {
    val ctx = LocalContext.current
    var pin by remember { mutableStateOf("") }
    var login by remember { mutableStateOf(false) }
    var folder by remember { mutableStateOf<String?>(null) }
    var fullList by remember { mutableStateOf<List<File>>(emptyList()) }
    var fullIndex by remember { mutableStateOf(0) }
    var showFull by remember { mutableStateOf(false) }
    val vault = File(ctx.filesDir, "vault").apply { if (!exists()) mkdirs() }
    var refresh by remember { mutableStateOf(0) }

    fun exportFile(f: File) {
        try {
            val ext = f.extension.lowercase()
            val isImg = ext in listOf("jpg","jpeg","png")
            val isVid = ext == "mp4"
            val coll = if (isImg) MediaStore.Images.Media.EXTERNAL_CONTENT_URI else if (isVid) MediaStore.Video.Media.EXTERNAL_CONTENT_URI else MediaStore.Downloads.EXTERNAL_CONTENT_URI
            val rel = if (isImg) Environment.DIRECTORY_PICTURES + "/RianDokumen" else if (isVid) Environment.DIRECTORY_MOVIES + "/RianDokumen" else Environment.DIRECTORY_DOWNLOADS + "/RianDokumen"
            val cv = ContentValues()
            cv.put(MediaStore.MediaColumns.DISPLAY_NAME, f.name)
            cv.put(MediaStore.MediaColumns.RELATIVE_PATH, rel)
            val uri = ctx.contentResolver.insert(coll, cv)
            if (uri!= null) { ctx.contentResolver.openOutputStream(uri)?.use { o -> f.inputStream().use { i -> i.copyTo(o) } }; Toast.makeText(ctx, "Export OK di Galeri", Toast.LENGTH_SHORT).show() }
        } catch (e: Exception) { Toast.makeText(ctx, e.message, Toast.LENGTH_LONG).show() }
    }

    val pick = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { u ->
        if (u!= null && folder!= null) {
            try {
                val dir = File(vault, folder!!).apply { if (!exists()) mkdirs() }
                val ext = when (folder) { "Photos" -> "jpg"; "Videos" -> "mp4"; "PDF" -> "pdf"; else -> "docx" }
                val dest = File(dir, "${System.currentTimeMillis()}.$ext")
                ctx.contentResolver.openInputStream(u)?.use { i -> dest.outputStream().use { o -> i.copyTo(o) } }
                refresh++
            } catch (e: Exception) {}
        }
    }

    if (showFull) {
        val pagerState = rememberPagerState(initialPage = fullIndex, pageCount = { fullList.size })
        Box(Modifier.fillMaxSize().background(Color.Black)) {
            HorizontalPager(state = pagerState, modifier = Modifier.fillMaxSize()) { page ->
                val f = fullList[page]
                val bmp = remember(f) { try { BitmapFactory.decodeFile(f.absolutePath) } catch(e: Exception){ null } }
                if (bmp!= null) Image(bitmap = bmp.asImageBitmap(), contentDescription = null, modifier = Modifier.fillMaxSize(), contentScale = ContentScale.Fit)
            }
            Row(Modifier.fillMaxWidth().padding(top = 40.dp, start = 16.dp, end = 16.dp).align(Alignment.TopCenter), horizontalArrangement = Arrangement.SpaceBetween) {
                Box(Modifier.background(Color(0x88000000), CircleShape).clickable { showFull = false }.padding(16.dp, 8.dp)) { Text("‹", color = Color.White, fontSize = 20.sp) }
                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                    Box(Modifier.background(Color(0x88000000), CircleShape).clickable { exportFile(fullList[pagerState.currentPage]) }.padding(12.dp)) { Text("⤓", color = Color.White) }
                    Box(Modifier.background(Color(0x88000000), CircleShape).clickable { val f = fullList[pagerState.currentPage]; f.delete(); fullList = fullList.filter { it!= f }; if (fullList.isEmpty()) showFull = false }.padding(12.dp)) { Text("🗑️", color = Color.White) }
                }
            }
            Box(Modifier.align(Alignment.BottomCenter).padding(bottom = 20.dp).background(Color(0x88000000), RoundedCornerShape(20.dp)).padding(12.dp, 6.dp)) { Text("${pagerState.currentPage + 1} / ${fullList.size}", color = Color.White, fontSize = 12.sp) }
        }
        return
    }

    if (!login) {
        Box(Modifier.fillMaxSize().background(Color.Black), contentAlignment = Alignment.Center) {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text("Rian Dokumen", color = Color.White, fontSize = 18.sp)
                Spacer(Modifier.height(20.dp))
                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) { for (i in 0..5) Box(Modifier.size(10.dp).background(if (i < pin.length) Color.White else Color(0xFF333333), CircleShape)) }
                Spacer(Modifier.height(30.dp))
                val keys = listOf("1","2","3","4","5","6","7","8","9","","0","⌫")
                LazyVerticalGrid(columns = GridCells.Fixed(3), modifier = Modifier.width(240.dp)) {
                    items(keys.size) { idx ->
                        val k = keys[idx]
                        if (k == "") Box(Modifier.size(70.dp))
                        else Box(Modifier.size(70.dp).background(Color(0xFF222222), CircleShape).clickable { if (k == "⌫") { if (pin.isNotEmpty()) pin = pin.dropLast(1) } else { if (pin.length < 6) pin += k; if (pin.length == 6) { if (pin == "123456") login = true else pin = "" } } }, contentAlignment = Alignment.Center) { Text(k, color = Color.White, fontSize = 22.sp) }
                    }
                }
            }
        }
        return
    }

    if (folder == null) {
        Column(Modifier.fillMaxSize().background(Color.Black).padding(16.dp)) {
            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                Text("Vault", color = Color.White, fontSize = 32.sp, fontWeight = FontWeight.Bold)
                Text("PRO", modifier = Modifier.background(Color(0xFFD4AF37), RoundedCornerShape(6.dp)).padding(6.dp, 2.dp), color = Color.Black, fontSize = 10.sp)
            }
            Spacer(Modifier.height(20.dp))
            LazyVerticalGrid(columns = GridCells.Fixed(2), verticalArrangement = Arrangement.spacedBy(12.dp), horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                item { Card(Modifier.fillMaxWidth().clickable { folder = "Docx" }, colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) { Column(Modifier.padding(16.dp)) { Text("📄", fontSize = 24.sp); Text("Docx", color = Color.White) } } }
                item { Card(Modifier.fillMaxWidth().clickable { folder = "XLSX" }, colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) { Column(Modifier.padding(16.dp)) { Text("📊", fontSize = 24.sp); Text("XLSX", color = Color.White) } } }
                item { Card(Modifier.fillMaxWidth().clickable { folder = "PDF" }, colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) { Column(Modifier.padding(16.dp)) { Text("📕", fontSize = 24.sp); Text("PDF", color = Color.White) } } }
                item { val c = File(vault, "Photos").listFiles()?.size?:0; Card(Modifier.fillMaxWidth().clickable { folder = "Photos" }, colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) { Column(Modifier.padding(16.dp)) { Text("🖼️", fontSize = 24.sp); Text("Photos", color = Color.White); Text("$c items", color = Color.Gray, fontSize = 11.sp) } } }
                item { Card(Modifier.fillMaxWidth().clickable { folder = "Videos" }, colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) { Column(Modifier.padding(16.dp)) { Text("🎬", fontSize = 24.sp); Text("Videos", color = Color.White) } } }
                item { Card(Modifier.fillMaxWidth().clickable { folder = "Secure" }, colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) { Column(Modifier.padding(16.dp)) { Text("🔒", fontSize = 24.sp); Text("Secure", color = Color.White) } } }
            }
        }
    } else {
        val dir = File(vault, folder!!)
        val files = remember(refresh, folder) { dir.listFiles()?.sortedByDescending { it.lastModified() }?: emptyList() }
        val isPhotos = folder == "Photos"

        Column(Modifier.fillMaxSize().background(Color.Black)) {
            Row(Modifier.fillMaxWidth().padding(16.dp), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Box(Modifier.background(Color(0xFF222222), CircleShape).clickable { folder = null }.padding(14.dp, 8.dp)) { Text("‹ Back", color = Color.White, fontSize = 14.sp) }
                    Spacer(Modifier.width(12.dp))
                    Text(folder!!, color = Color.White, fontWeight = FontWeight.Bold, fontSize = 22.sp)
                }
                Row {
                    Text("🔍", modifier = Modifier.padding(8.dp).clickable {})
                    Spacer(Modifier.width(8.dp))
                    Text("⋮", color = Color.White, fontSize = 20.sp, modifier = Modifier.padding(8.dp))
                }
            }

            if (isPhotos) {
                Column {
                    Text("Foto", color = Color.White, fontSize = 42.sp, fontWeight = FontWeight.Bold, modifier = Modifier.padding(start = 16.dp, bottom = 8.dp))
                    Text("Hari ini - Kemarin", color = Color.White, fontSize = 18.sp, fontWeight = FontWeight.Bold, modifier = Modifier.padding(start = 16.dp, bottom = 12.dp))

                    LazyVerticalGrid(columns = GridCells.Fixed(4), modifier = Modifier.fillMaxSize(), contentPadding = PaddingValues(1.dp), verticalArrangement = Arrangement.spacedBy(1.dp), horizontalArrangement = Arrangement.spacedBy(1.dp)) {
                        items(files.size) { idx ->
                            val f = files[idx]
                            val bmp = remember(f) { try { BitmapFactory.decodeFile(f.absolutePath) } catch(e: Exception){ null } }
                            Box(Modifier.aspectRatio(1f).background(Color(0xFF222222)).clickable {
                                fullList = files
                                fullIndex = idx
                                showFull = true
                            }) {
                                if (bmp!= null) Image(bitmap = bmp.asImageBitmap(), contentDescription = null, modifier = Modifier.fillMaxSize(), contentScale = ContentScale.Crop)
                                if (f.extension.lowercase() == "mp4") {
                                    Box(Modifier.fillMaxSize().background(Color(0x44000000)), contentAlignment = Alignment.Center) {
                                        Box(Modifier.background(Color(0x88000000), CircleShape).padding(6.dp)) { Text("▶", color = Color.White, fontSize = 12.sp) }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                Column(Modifier.padding(16.dp)) {
                    Button(onClick = { pick.launch("*/*") }, modifier = Modifier.fillMaxWidth(), colors = ButtonDefaults.buttonColors(containerColor = Color.White)) { Text("+ Tambah ke $folder", color = Color.Black) }
                    Spacer(Modifier.height(12.dp))
                    LazyVerticalGrid(columns = GridCells.Fixed(2), verticalArrangement = Arrangement.spacedBy(8.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                        items(files.size) { idx ->
                            val f = files[idx]
                            Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF1A1A1A))) {
                                Column(Modifier.padding(12.dp)) {
                                    Text(f.name, color = Color.White, fontSize = 11.sp, maxLines = 1)
                                    Text("${f.length()/1024} KB", color = Color.Gray, fontSize = 10.sp)
                                    Spacer(Modifier.height(8.dp))
                                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                                        Box(Modifier.background(Color.White, RoundedCornerShape(8.dp)).clickable {
                                            if (f.extension.lowercase() in listOf("jpg","jpeg","png")) { fullList = files.filter { it.extension.lowercase() in listOf("jpg","jpeg","png") }; fullIndex = fullList.indexOf(f); showFull = true } else {
                                                val mime = if (f.extension.lowercase() == "pdf") "application/pdf" else "*/*"
                                                try { val intent = Intent(Intent.ACTION_VIEW).apply { setDataAndType(androidx.core.content.FileProvider.getUriForFile(ctx, ctx.packageName + ".provider", f), mime); addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION) }; ctx.startActivity(intent) } catch(e: Exception) { exportFile(f) }
                                            }
                                        }.padding(10.dp, 4.dp)) { Text("Buka", color = Color.Black, fontSize = 10.sp, fontWeight = FontWeight.Bold) }
                                        Box(Modifier.background(Color(0xFF00E676), RoundedCornerShape(8.dp)).clickable { exportFile(f) }.padding(10.dp, 4.dp)) { Text("Export", color = Color.White, fontSize = 10.sp) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
